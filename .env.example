# CareConnect local configuration reference.
# Copy backend/env.example to backend/.env and frontend/env.example to frontend/.env.
# Do not put real secrets in this file or commit local .env files.

# Backend defaults: PORT=5001, MONGODB_URI=mongodb://127.0.0.1:27017/careconnect
# Frontend local API: VITE_CARECONNECT_API_URL=http://localhost:5001/api
