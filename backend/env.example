# Copy this file to .env and replace all placeholder values.
NODE_ENV=development
PORT=5001
CLIENT_ORIGIN=http://localhost:5173
# For hosted deployments, add every trusted frontend origin, comma-separated.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MONGODB_URI=mongodb://127.0.0.1:27017/careconnect

# Generate independent random values of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_NAME=careconnect_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# Leave SMTP_HOST empty for local development; OTPs are logged to backend console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CareConnect <no-reply@careconnect.local>
EMAIL_DEV_LOG=true

# Optional Twilio SMS configuration. All three values are required to send SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DEV_LOG=true

# Production example:
# NODE_ENV=production
# CLIENT_ORIGINS=https://your-frontend-domain.example
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
